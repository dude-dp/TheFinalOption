{
  "name": "thefinaloption",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat"],
  // KV Namespace for auth tokens and bot state
  "kv_namespaces": [
    { "binding": "TRADING_KV", "id": "b6afdd31728c4a4d8e3bb7690014b579" }
  ],
  // D1 SQLite for persistent trade logs and config
  "d1_databases": [
    {
      "binding": "TRADING_DB",
      "database_name": "thefinaloption-db",
      "database_id": "a3b9df2e-d18b-41a1-82f1-d4369c2bb74d"
    }
  ],
  // MTF Screener Queue — Producer pushes batches, 5 concurrent consumers process them
  "queues": {
    "producers": [
      { "binding": "MTF_QUEUE", "queue": "mtf-screener-queue" }
    ],
    "consumers": [
      {
        "queue": "mtf-screener-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_concurrency": 5,
        "max_retries": 2,
        "dead_letter_queue": "mtf-screener-dlq"
      }
    ]
  },
  // Cron Triggers — fires exactly 1 min after each 15/30m candle close (IST offset)
  // 16,31,46,1 at 3-9 UTC  = 09:16-15:01 IST (30m candle cadence)
  // 16,31,35 at 10 UTC      = 15:46, 16:01, 16:05 IST (EOD window)
  // 30 18 UTC               = Midnight IST config snapshot
  "triggers": {
    "crons": [
      "16,31,46,1 3-9 * * MON-FRI",
      "16,31,35 10 * * MON-FRI",
      "30 18 * * *"
    ]
  },
  // Static assets (dashboard CSS, JS)
  "assets": { "directory": "./src/static" },
  // Public vars — secrets set via `wrangler secret put`
  "vars": {
    "SUPABASE_URL": "https://pwapzcnichfcmghnyxxo.supabase.co",
    "UPSTOX_REDIRECT_URI": "https://thefinaloption.thefinaloptionautomation.workers.dev/oauth/callback",
    "ENVIRONMENT": "production"
  }
  // Secrets (set via CLI):
  //   wrangler secret put SUPABASE_SERVICE_KEY
  //   wrangler secret put UPSTOX_CLIENT_SECRET
  //   wrangler secret put POLL_SECRET
  //   wrangler secret put DISCORD_MTF_WEBHOOK
  //   wrangler secret put GROQ_API_KEY
}